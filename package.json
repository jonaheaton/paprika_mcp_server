{
  "name": "paprika-recipe-manager",
  "version": "1.0.0",
  "description": "MCP server for accessing Paprika recipe database",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --inspect server/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:basic": "node test/basic-test.js",
    "test:write": "node test/write-operations-test.js",
    "test:inspector": "node test/inspector-test.js",
    "test:runner": "node scripts/test-runner.js",
    "test:runner:watch": "node scripts/test-runner.js --watch",
    "test:runner:ci": "node scripts/test-runner.js --ci --coverage",
    "test:all": "node scripts/test-runner.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "mcp",
    "paprika",
    "recipes",
    "cooking",
    "meal-planning",
    "dxt"
  ],
  "author": "Jonah Eaton <jonah@jonaheaton.com> (https://github.com/jonaheaton)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonaheaton/paprika_mcp_server"
  }
}